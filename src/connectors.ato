# Connectors — All JST-SH 1.0mm pitch
# See specs/motors-esc.md, specs/uarts-receiver.md, specs/video-vtx-misc.md

module ESCConnector:
    # 8-pin JST-SH: GND, VBAT, CURR, M1-M4, TELEM
    signal gnd
    signal vbat
    signal curr
    signal m1
    signal m2
    signal m3
    signal m4
    signal telem

module RXConnector:
    # 4-pin JST-SH: GND, 5V, RX1, TX1
    signal gnd
    signal v5
    signal rx
    signal tx

module GPSConnector:
    # 6-pin JST-SH: GND, 5V, TX2, RX2, SCL, SDA
    signal gnd
    signal v5
    signal tx
    signal rx
    signal scl
    signal sda

module SpareConnector:
    # 6-pin JST-SH: GND, 5V, TX3, RX3, 5V, GND
    signal gnd
    signal v5
    signal tx
    signal rx

module CameraConnector:
    # 3-pin JST-SH: GND, 5V, VOUT
    signal gnd
    signal v5
    signal video_out

module VTXConnector:
    # 4-pin JST-SH: GND, VBAT_SW, VIDEO, SA
    signal gnd
    signal vbat_sw
    signal video_in
    signal smart_audio
