# TF405 Research Flight Controller
# Top-level module composing all subsystems
#
# Architecture:
#   VBAT → 5V Buck (TI LMR43620) → 3.3V LDO (AMS1117) → MCU + peripherals
#   MCU (STM32F405RGT6) connects to:
#     SPI1 → BMI270 IMU
#     SPI2 → AT7456E OSD
#     SPI3 → W25Q128 Flash
#     I2C1 → BMP390 Baro (+ external mag via GPS connector)
#     UARTs → RX, GPS, ESC telemetry, VTX SmartAudio, spare
#     TIM8  → 4x motor DShot outputs
#     USB   → USB-C for DFU/configurator
#     ADC   → VBAT sense, current sense, RSSI

from "power.ato" import PowerSystem
from "mcu.ato" import MCU_F405, MountingHole_M3
from "imu.ato" import IMU_BMI270
from "osd.ato" import OSD_AT7456E
from "flash.ato" import Flash_W25Q128
from "baro.ato" import Baro_BMP390
from "usb.ato" import USB_C_Interface
from "connectors.ato" import ESCConnector, RXConnector, GPSConnector, CameraConnector, VTXConnector
from "misc.ato" import StatusLED, Beeper, LEDStrip, PA4Breakout, SBUSInverter

module TF405:
    # ── Mounting Holes (30.5mm M3 pattern) ──
    # Defined in ato so they persist through ato build (not stripped from PCB).
    # Non-plated, no electrical connection — matches Brave F7 reference.
    # Position in KiCad layout:
    #   H1 (103.5, 103.5), H2 (133.5, 103.5), H3 (103.5, 133.5), H4 (133.5, 133.5)
    h1 = new MountingHole_M3
    h2 = new MountingHole_M3
    h3 = new MountingHole_M3
    h4 = new MountingHole_M3

    # ── Power ──
    power = new PowerSystem

    # ── MCU ──
    mcu = new MCU_F405
    mcu.vdd ~ power.rail_3v3
    mcu.vdda ~ power.rail_3v3  # filtered separately inside MCU module

    # Power ADC connections: battery voltage and current sense to MCU ADC
    power.adc_vbat ~ mcu.pc2   # Battery voltage divider output -> ADC_VBAT
    power.adc_curr ~ mcu.pc1   # Current sense filter output -> ADC_CURR
    # PINIO1: MCU PB2 controls P-FET gate for VTX power switching
    power.pinio1 ~ mcu.pb2

    # ── IMU (SPI1) ──
    imu = new IMU_BMI270
    imu.vdd ~ power.rail_3v3
    imu.spi_sck ~ mcu.pa5
    imu.spi_miso ~ mcu.pa6
    imu.spi_mosi ~ mcu.pa7
    imu.cs ~ mcu.pc4
    imu.exti ~ mcu.pc5
    imu.gnd ~ power.gnd

    # ── OSD (SPI2) ──
    osd = new OSD_AT7456E
    osd.dvdd ~ power.rail_3v3
    osd.avdd ~ power.rail_3v3  # through ferrite bead inside OSD module
    osd.spi_sck ~ mcu.pb13
    osd.spi_miso ~ mcu.pb14
    osd.spi_mosi ~ mcu.pb15
    osd.cs ~ mcu.pb12
    osd.gnd ~ power.gnd

    # ── Blackbox Flash (SPI3) ──
    flash = new Flash_W25Q128
    flash.vcc ~ power.rail_3v3
    flash.spi_sck ~ mcu.pc10
    flash.spi_miso ~ mcu.pc11
    flash.spi_mosi ~ mcu.pb5
    flash.cs ~ mcu.pb7
    flash.gnd ~ power.gnd

    # ── Barometer (I2C1) ──
    baro = new Baro_BMP390
    baro.vdd ~ power.rail_3v3
    baro.scl ~ mcu.pb8
    baro.sda ~ mcu.pb9
    baro.gnd ~ power.gnd

    # ── USB-C ──
    usb = new USB_C_Interface
    usb.dm ~ mcu.pa11
    usb.dp ~ mcu.pa12
    usb.gnd ~ power.gnd
    # USB VBUS feeds into power OR circuit (SS34 Schottky → 5V rail in power.ato)
    usb.vbus ~ power.usb_vbus

    # ── Connectors ──
    esc_conn = new ESCConnector
    rx_conn = new RXConnector
    gps_conn = new GPSConnector
    cam_conn = new CameraConnector
    vtx_conn = new VTXConnector

    # ── Video Path Wiring (TASK-010) ──
    # Analog video chain: Camera → AT7456E OSD overlay → VTX
    # Video is composite analog — does NOT pass through the MCU.
    # 75Ω impedance matching is a PCB layout constraint (trace width), not enforced in .ato.
    cam_conn.video_out ~ osd.video_in    # Camera composite video → OSD VIN (pin 8)
    osd.video_out ~ vtx_conn.video_in    # OSD composited VOUT (pin 3) → VTX
    # Camera power: 5V regulated from buck converter, ground to system GND
    cam_conn.v5 ~ power.rail_5v
    cam_conn.gnd ~ power.gnd
    cam_conn.gnd_2 ~ power.gnd
    # Camera control: PB3 Betaflight OSD joystick emulation via connector pin 4
    cam_conn.cam_ctrl ~ mcu.pb3
    # VTX power: 10V regulated BEC, switchable via PINIO1 (N-FET + P-FET in power.ato)
    # Allows Betaflight to power-cycle the VTX for pit mode / channel changes
    vtx_conn.v10 ~ power.vtx_10v
    vtx_conn.gnd ~ power.gnd
    # VTX control: full UART5 for SmartAudio / IRC Tramp bidirectional protocol
    # TX used for SmartAudio; RX enables IRC Tramp and SmartAudio v2.1 responses
    vtx_conn.uart_tx ~ mcu.pc12        # UART5_TX (PC12) → VTX control TX
    vtx_conn.uart_rx ~ mcu.pd2         # UART5_RX (PD2) → VTX control RX

    # ── ESC Connector Wiring (TASK-009) ──
    # Motor outputs: TIM8 CH1-CH4 for DShot PWM (not bitbanged, DMA2 errata ES0206 §2.1.10)
    # All 4 motors on same timer ensures synchronized PWM updates via DMA2
    mcu.pc6 ~ esc_conn.m1   # TIM8_CH1 → Motor 1
    mcu.pc7 ~ esc_conn.m2   # TIM8_CH2 → Motor 2
    mcu.pc8 ~ esc_conn.m3   # TIM8_CH3 → Motor 3
    mcu.pc9 ~ esc_conn.m4   # TIM8_CH4 → Motor 4
    # ESC telemetry: half-duplex UART4 on PA1 for RPM/voltage/current/temp feedback
    mcu.pa1 ~ esc_conn.telem   # UART4_RX → ESC telemetry
    # Current sense: ESC connector CURR pin → power module filter (1kΩ + 100nF RC, fc~1.6kHz) → MCU PC1 ADC
    esc_conn.curr ~ power.curr_in
    # ESC power: battery voltage passthrough and ground
    esc_conn.vbat ~ power.vbat
    esc_conn.gnd ~ power.gnd

    # ── Misc Peripherals ──
    led = new StatusLED
    led.gpio ~ mcu.pb0
    led.vdd ~ power.rail_3v3
    led.gnd ~ power.gnd

    beeper = new Beeper
    beeper.gpio ~ mcu.pb1
    beeper.vdd ~ power.rail_5v   # 5V supply for passive buzzer (MLT-8530)
    beeper.gnd ~ power.gnd

    led_strip = new LEDStrip
    led_strip.data ~ mcu.pb6
    led_strip.vdd ~ power.rail_5v
    led_strip.gnd ~ power.gnd

    # Camera control now routed through camera connector pin 4 (see video path wiring above)

    # PA4 breakout: servo/detonator solder pad (DAC_OUT1 / TIM2_CH1)
    pa4_out = new PA4Breakout
    pa4_out.gpio ~ mcu.pa4
    pa4_out.gnd ~ power.gnd

    # ── SBUS Inverter (TASK-012) ──
    # 2N7002 N-FET hardware inverter for SBUS protocol support
    # Must be instantiated before UART wiring references below
    sbus_inv = new SBUSInverter
    sbus_inv.vdd ~ power.rail_3v3
    sbus_inv.gnd ~ power.gnd

    # ── UART Connector Wiring (TASK-011) ──
    # RX Connector (UART1): Serial receiver input
    # Default: direct connection for CRSF/ELRS (non-inverted protocols)
    # SBUS: requires hardware inverter (2N7002 N-FET circuit in SBUSInverter module)
    # Selection: solder bridge on PCB routes RX1 through inverter or direct to PA10
    #
    # Direct path: rx_conn.rx → mcu.pa10 (via solder bridge, default)
    # SBUS path:  rx_conn.rx → sbus_inv.sbus_in → (inverted) → sbus_inv.uart_rx → mcu.pa10
    # Both paths converge on PA10; only one should be active at a time (solder bridge)
    rx_conn.tx ~ mcu.pa9       # UART1_TX → receiver telemetry return
    rx_conn.v5 ~ power.rail_5v
    rx_conn.gnd ~ power.gnd
    # SBUS inverter: input from RX connector, output to UART1_RX
    sbus_inv.sbus_in ~ rx_conn.rx   # RX connector → inverter gate (via 1kΩ)
    sbus_inv.uart_rx ~ mcu.pa10     # Inverter drain → UART1_RX (PA10)

    # GPS Connector (UART2 + I2C1): GPS module + external magnetometer
    # UART2 for NMEA/UBX GPS data, I2C1 for external magnetometer (HMC5883L/QMC5883L)
    # I2C1 bus pullups (4.7kΩ to 3.3V) already in baro module — shared bus
    gps_conn.tx ~ mcu.pa2      # UART2_TX → GPS module RX
    gps_conn.rx ~ mcu.pa3      # UART2_RX → GPS module TX
    gps_conn.scl ~ mcu.pb8     # I2C1_SCL → external magnetometer SCL
    gps_conn.sda ~ mcu.pb9     # I2C1_SDA → external magnetometer SDA
    gps_conn.v5 ~ power.rail_5v
    gps_conn.gnd ~ power.gnd

    # UART3 (PB10/PB11) available — will be routed to solder pads at board perimeter
