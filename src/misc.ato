# Miscellaneous peripherals
# See specs/video-vtx-misc.md

module StatusLED:
    signal gpio  # PB0, active low
    signal vdd
    signal gnd
    # TODO: LED + current limiting resistor (typically 1k for 3.3V/~1.5mA)

module Beeper:
    signal gpio  # PB1, inverted (drives N-FET)
    signal gnd
    # TODO: N-FET (2N7002) gate driver + passive buzzer on 5V

module LEDStrip:
    signal data  # PB6, WS2812 data
    signal vdd   # 5V
    signal gnd
    # TODO: Series resistor (~330 ohm) on data line

module CameraControl:
    signal gpio  # PB3, Betaflight camera OSD joystick
    signal gnd
    # TODO: Simple solder pad breakout

module SBUSInverter:
    signal vdd      # 3.3V
    signal gnd
    signal sbus_in  # From SBUS receiver
    signal uart_rx  # To UART1_RX (PA10)
    # TODO: 2N7002 N-FET inverter circuit
    # TODO: 1k gate resistor, 10k pullup on drain
    # TODO: Solder bridge for SBUS vs direct (CRSF/ELRS) selection
