# Miscellaneous peripherals
# See specs/video-vtx-misc.md, specs/uarts-receiver.md

from "mcu.ato" import Resistor

# ────────────────────────────────────────────────
# 2N7002 N-Channel MOSFET (SOT-23)
# Used for SBUS signal inversion and buzzer drive
# Pin mapping from ON Semiconductor datasheet
# ────────────────────────────────────────────────
component NFET_2N7002:
    footprint = "SOT-23"
    mpn = "2N7002"
    designator_prefix = "Q"
    signal gate ~ pin 1
    signal source ~ pin 2
    signal drain ~ pin 3

# ────────────────────────────────────────────────
# Standard 0603 SMD LED
# Used for board status indication (green, common 0603 package)
# ────────────────────────────────────────────────
component LED_0603:
    footprint = "LED_0603_1608Metric"
    mpn = "19-217/GHC-YR1S2/3T"
    designator_prefix = "D"
    signal anode ~ pin 2
    signal cathode ~ pin 1

# ────────────────────────────────────────────────
# Status LED (active low)
# PB0 sinks current when driven low → LED turns on.
# Circuit: 3.3V → 1kΩ → LED anode, LED cathode → PB0 (GPIO)
# At Vf~2.0V, I = (3.3 - 2.0) / 1kΩ ≈ 1.3mA — bright enough for status
# ────────────────────────────────────────────────
module StatusLED:
    signal gpio  # PB0, active low
    signal vdd
    signal gnd

    # Current limiting resistor: 1kΩ for ~1.3mA @ 3.3V with green LED (Vf~2.0V)
    r_led = new Resistor
    r_led.value = 1kohm +/- 1%

    # 0603 green status LED
    led = new LED_0603

    # Active-low wiring: VDD → resistor → LED anode; LED cathode → GPIO
    # GPIO sinks current when driven low, turning the LED on
    vdd ~ r_led.p1; r_led.p2 ~ led.anode
    led.cathode ~ gpio

    # ── Assert constraints (spec validation) ──
    assert r_led.value within 900ohm to 1.1kohm

# ────────────────────────────────────────────────
# MLT-8530 Passive Piezo Buzzer (SMD, 8.5x8.5x3mm)
# Standard on Betaflight FCs. Passive type requires square-wave
# drive from MCU (Betaflight generates ~4kHz via timer).
# Resonant freq: 2.7kHz, 80dB SPL, coil resistance 12±3Ω.
# ────────────────────────────────────────────────
component Buzzer_MLT8530:
    footprint = "Buzzer_Beeper:Buzzer_SMD_MLT-8530_8.5x8.5mm"
    mpn = "MLT-8530"
    designator_prefix = "BZ"
    signal positive ~ pin 1
    signal negative ~ pin 2

# ────────────────────────────────────────────────
# Beeper Circuit (N-FET low-side drive)
# PB1 drives 2N7002 gate via 10kΩ resistor. FET switches buzzer
# ground path: 5V → buzzer+ → buzzer- → FET drain → GND.
# Betaflight BEEPER_INVERTED = ON: PB1 high → FET on → buzzer sounds.
# 10kΩ gate resistor limits inrush and provides ESD protection;
# slower gate charge is acceptable since buzzer freq is only ~4kHz.
# ────────────────────────────────────────────────
module Beeper:
    signal gpio  # PB1, active high (drives N-FET gate)
    signal vdd   # 5V for buzzer supply
    signal gnd

    # N-channel MOSFET: 2N7002 SOT-23 (Vgs_th ~1.5V, handles 3.3V logic)
    q_beep = new NFET_2N7002

    # Gate resistor: 10kΩ limits gate inrush current and provides ESD protection
    # 10kΩ is adequate since buzzer PWM is only ~4kHz (rise time not critical)
    r_gate = new Resistor
    r_gate.value = 10kohm +/- 1%
    gpio ~ r_gate.p1; r_gate.p2 ~ q_beep.gate

    # Source to ground (N-FET low-side switch topology)
    q_beep.source ~ gnd

    # Passive buzzer: MLT-8530 (8.5mm SMD, 3.6V nominal, 80dB SPL)
    # Connected between 5V supply and FET drain — FET switches ground path
    buzzer = new Buzzer_MLT8530
    vdd ~ buzzer.positive
    buzzer.negative ~ q_beep.drain

    # ── Assert constraints (spec validation) ──
    assert r_gate.value within 9.9kohm to 10.1kohm

module LEDStrip:
    signal data  # PB6, WS2812 data
    signal vdd   # 5V
    signal gnd
    # TODO: Series resistor (~330 ohm) on data line

module CameraControl:
    signal gpio  # PB3, Betaflight camera OSD joystick
    signal gnd
    # TODO: Simple solder pad breakout

# ────────────────────────────────────────────────
# SBUS Hardware Inverter (STM32F405-specific)
# STM32F405 lacks UART hardware inversion capability.
# SBUS protocol uses inverted UART (idle-low), so an external
# N-FET inverter is required to convert to standard UART levels.
#
# Circuit: SBUS_IN → 1kΩ → Gate(2N7002), Source→GND,
#          Drain → 10kΩ pullup to 3.3V → UART1_RX (PA10)
#
# When SBUS_IN is high (idle): FET on → drain pulled low → UART sees low (inverted)
# When SBUS_IN is low (data):  FET off → drain pulled high → UART sees high (inverted)
#
# Default path is direct (CRSF/ELRS, non-inverted). The SBUS path
# through the inverter is selected by bridging a solder jumper.
# Both paths converge on uart_rx which connects to PA10.
# ────────────────────────────────────────────────
module SBUSInverter:
    signal vdd      # 3.3V
    signal gnd
    signal sbus_in  # From SBUS receiver (inverted UART, idle-high)
    signal uart_rx  # To UART1_RX (PA10)

    # N-channel MOSFET: 2N7002 SOT-23 (Vgs_th ~1.5V, handles 3.3V logic)
    q_inv = new NFET_2N7002

    # Gate resistor: 1kΩ limits gate inrush current and provides ESD protection
    # SBUS signal → 1kΩ → gate
    r_gate = new Resistor
    r_gate.value = 1kohm +/- 1%
    sbus_in ~ r_gate.p1; r_gate.p2 ~ q_inv.gate

    # Source to ground (N-FET common-source inverter topology)
    q_inv.source ~ gnd

    # Drain pullup: 10kΩ to 3.3V sets the output high when FET is off
    # 10kΩ chosen for low power consumption (~330µA when FET is on)
    # while maintaining fast enough rise time for 100kbaud SBUS
    r_pullup = new Resistor
    r_pullup.value = 10kohm +/- 1%
    q_inv.drain ~ r_pullup.p1; r_pullup.p2 ~ vdd

    # Inverted output goes to UART1_RX
    q_inv.drain ~ uart_rx

    # ── Assert constraints (spec validation) ──
    assert r_gate.value within 900ohm to 1.1kohm
    assert r_pullup.value within 9.9kohm to 10.1kohm
