# Power subsystem: VBAT -> 5V Buck (MP1584EN) -> 3.3V LDO (AMS1117-3.3)
# See specs/power.md for full requirements
#
# Design decisions:
# - MP1584EN SOIC-8 buck converter: 4.5-28V input, 5V/3A output, 1.5MHz switching
#   Feedback divider: R_fb_top=210kohm / R_fb_bot=40kohm sets Vout = 0.8V*(1+210/40) = 5.0V
#   These are the datasheet-recommended values for 5V output.
# - AMS1117-3.3 SOT-223 LDO: 5V input, 3.3V/1A output
#   22uF tantalum output cap required for stability (ESR-dependent loop compensation)
# - SMBJ26A TVS: clamp voltage ~29V protects against 6S voltage spikes
# - Battery voltage divider: 10k/1k gives 10:1 ratio, 25.2V -> 2.29V (safe for 3.3V ADC)
# - Current sense filter: 1kohm + 100nF RC low-pass, fc = 1/(2*pi*1k*100n) ~= 1.6kHz
# - PINIO1: AO3401A P-FET high-side switch for VTX power control via PB2
#   10kohm gate resistor limits gate current and provides noise immunity
# - SS34 Schottky diode: USB power OR circuit prevents backfeed from BEC to USB host

from "mcu.ato" import Capacitor, Resistor
from "misc.ato" import NFET_2N7002

# ────────────────────────────────────────────────
# MP1584EN Step-Down (Buck) Converter — SOIC-8
# Pin mapping from MPS datasheet DS1001a Rev 1.1
# Input: 4.5-28V, Output: adjustable, Max 3A, up to 1.5MHz switching
# ────────────────────────────────────────────────
component MP1584EN:
    footprint = "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
    mpn = "MP1584EN-LF-Z"
    designator_prefix = "U"
    signal sw ~ pin 1      # Switch node output — connects to inductor
    signal en ~ pin 2      # Enable (active high, internal pullup)
    signal comp ~ pin 3    # Error amplifier compensation output
    signal fb ~ pin 4      # Feedback input (0.8V reference)
    signal gnd ~ pin 5     # Ground (also thermal pad)
    signal freq ~ pin 6    # Switching frequency set (resistor to GND)
    signal vin ~ pin 7     # Input supply (4.5-28V)
    signal bst ~ pin 8     # Bootstrap supply for high-side driver

# ────────────────────────────────────────────────
# AMS1117-3.3 LDO Voltage Regulator — SOT-223
# Pin mapping from AMS datasheet
# Fixed 3.3V output, 1A max, dropout ~1.2V typical
# Note: Tab (pin 4) is electrically connected to VOUT (pin 2)
# ────────────────────────────────────────────────
component AMS1117_3V3:
    footprint = "Package_TO_SOT_SMD:SOT-223-3_TabPin2"
    mpn = "AMS1117-3.3"
    designator_prefix = "U"
    signal gnd ~ pin 1     # Ground
    signal vout ~ pin 2    # Regulated 3.3V output (also connected to tab)
    signal vin ~ pin 3     # Input supply (4.5-15V recommended)

# ────────────────────────────────────────────────
# SMBJ26A TVS Diode — SMB package
# Standoff voltage: 26V, Clamping voltage: ~42.1V @ 1A (protects 6S LiPo)
# Unidirectional: cathode band toward VBAT (reverse-biased during normal operation)
# ────────────────────────────────────────────────
component TVS_SMBJ26A:
    footprint = "Diode_SMD:D_SMB"
    mpn = "SMBJ26A"
    designator_prefix = "D"
    signal anode ~ pin 1   # Connect to GND
    signal cathode ~ pin 2 # Connect to VBAT (reverse-biased)

# ────────────────────────────────────────────────
# SS34 Schottky Diode — SMA package
# 40V, 3A, Vf ~0.5V — used for USB power OR circuit
# Forward: anode=VBUS, cathode=5V rail (current flows USB→rail)
# ────────────────────────────────────────────────
component Schottky_SS34:
    footprint = "Diode_SMD:D_SMA"
    mpn = "SS34"
    designator_prefix = "D"
    signal anode ~ pin 1
    signal cathode ~ pin 2

# ────────────────────────────────────────────────
# AO3401A P-Channel MOSFET — SOT-23
# Vds=-30V, Id=-4A, Rds(on)=50mohm @ Vgs=-10V
# Used as high-side switch for VTX VBAT control (PINIO1)
# Pin mapping: SOT-23 standard for P-FET
# ────────────────────────────────────────────────
component AO3401A:
    footprint = "Package_TO_SOT_SMD:SOT-23"
    mpn = "AO3401A"
    designator_prefix = "Q"
    signal gate ~ pin 1    # Gate — driven by MCU PB2 via 10k resistor
    signal source ~ pin 2  # Source — connects to VBAT
    signal drain ~ pin 3   # Drain — connects to VTX VBAT_SW output

# ────────────────────────────────────────────────
# Shielded Power Inductor — for MP1584EN buck output
# 4.7uH, rated >= 3A saturation current
# Use shielded type to minimize EMI on sensitive analog circuits
# ────────────────────────────────────────────────
component Inductor_4u7:
    footprint = "Inductor_SMD:L_6.3x6.3_H3"
    mpn = "CDRH6D28HPNP-4R7NC"
    designator_prefix = "L"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

# ────────────────────────────────────────────────
# 22uF/10V tantalum, EIA-3528 (Kemet Case B)
# For 3.3V rail bulk decoupling and AMS1117 output stability.
# Tantalum provides necessary ESR (0.1-0.5ohm) for AMS1117 loop compensation —
# low-ESR MLCC can cause oscillation on this LDO.
# ────────────────────────────────────────────────
component Cap_22uF_10V_Tant:
    footprint = "Capacitor_Tantalum_SMD:CP_EIA-3528-21_Kemet-B"
    mpn = "TAJB226K010RNJ"
    designator_prefix = "C"
    signal p1 ~ pin 1  # positive
    signal p2 ~ pin 2  # negative (GND)

# ────────────────────────────────────────────────
# Voltage-rated caps for VBAT rail (up to 25.2V on 6S LiPo)
# Pinned MPNs required because atopile v0.2.69 generic solver
# has no voltage_rating constraint — it picks cheapest by capacitance only.
# ────────────────────────────────────────────────

# 22uF/35V X5R MLCC, 1210 package
# Samsung CL32A226KAJNNNE — LCSC C24497, JLCPCB basic part
# 35V matches c_vbat_bulk rating; 72% derating at 25.2V (6S max)
component Cap_22uF_35V:
    footprint = "Capacitor_SMD:C_1210_3225Metric"
    mpn = "CL32A226KAJNNNE"
    designator_prefix = "C"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

# ────────────────────────────────────────────────
# PowerSystem module: complete power distribution
# ────────────────────────────────────────────────
module PowerSystem:
    # ── Power rails exposed to rest of system ──
    signal vbat      # Raw battery input (7.4-25.2V, 2-6S LiPo)
    signal rail_5v   # 5V regulated rail (from MP1584EN buck)
    signal rail_3v3  # 3.3V regulated rail (from AMS1117)
    signal gnd       # Common ground reference

    # ── Sensing signals (exposed to MCU ADC pins) ──
    signal adc_vbat  # Battery voltage sense output (to PC2, ~2.29V at 6S max)
    signal adc_curr  # Current sense filtered output (to PC1)

    # ── 10V VTX power (switched) ──
    signal vtx_10v   # PINIO1 switched 10V output (to VTX connector)
    signal pinio1    # PINIO1 gate control input (from MCU PB2)

    # ── USB power OR input ──
    signal usb_vbus  # USB VBUS input (for power OR with BEC 5V)

    # ── ESC current sense input ──
    signal curr_in   # Raw current sense from ESC connector

    # ═══════════════════════════════════════════════
    # SECTION 1: VBAT Input Protection
    # TVS diode clamps voltage spikes (SMBJ26A, Vclamp ~42V)
    # 2x 22uF/35V MLCC bulk caps near battery pads
    # ═══════════════════════════════════════════════

    # TVS diode: cathode to VBAT, anode to GND (reverse-biased normally)
    tvs = new TVS_SMBJ26A
    tvs.cathode ~ vbat
    tvs.anode ~ gnd

    # Bulk input capacitors: 2x 22uF/35V MLCC (1210) near battery pads
    # Replaces single 100uF electrolytic — flat profile, lower ESR, no cylindrical cans
    # Effective ~44uF nominal (DC bias derating reduces this at 25.2V, still adequate
    # for high-frequency transient suppression from motor switching)
    c_vbat_bulk_1 = new Cap_22uF_35V
    vbat ~ c_vbat_bulk_1.p1; c_vbat_bulk_1.p2 ~ gnd
    c_vbat_bulk_2 = new Cap_22uF_35V
    vbat ~ c_vbat_bulk_2.p1; c_vbat_bulk_2.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 2: 5V Buck Regulator (MP1584EN)
    # Input: VBAT (7.4-25.2V), Output: 5V/3A
    # Switching frequency set by R_freq, ~1MHz typical
    # Feedback divider: 210k/40k for 5V output
    # Compensation: series RC on COMP pin for loop stability
    # ═══════════════════════════════════════════════

    buck = new MP1584EN

    # Input power connections
    buck.vin ~ vbat
    buck.gnd ~ gnd

    # Enable: tie to VIN for always-on operation
    # (EN has internal pullup, but explicit connection to VIN is more robust)
    buck.en ~ vbat

    # Input decoupling: 22uF/35V ceramic close to VIN pin
    # Low ESR ceramic handles high-frequency switching current
    # Pinned MPN — sits on VBAT rail (25.2V max), needs ≥35V rating
    c_buck_in = new Cap_22uF_35V
    buck.vin ~ c_buck_in.p1; c_buck_in.p2 ~ gnd

    # Bootstrap capacitor: 100nF between BST and SW pins
    # Charges during off-time, provides gate drive for high-side FET
    c_bst = new Capacitor
    c_bst.value = 100nF +/- 10%
    buck.bst ~ c_bst.p1; c_bst.p2 ~ buck.sw

    # Output inductor: 4.7uH/3A shielded, connects SW to output
    inductor = new Inductor_4u7
    buck.sw ~ inductor.p1; inductor.p2 ~ rail_5v

    # Schottky diode: catch diode for buck converter
    # Anode to GND, cathode to SW node — conducts during off-time
    d_buck = new Schottky_SS34
    d_buck.anode ~ gnd
    d_buck.cathode ~ buck.sw

    # Output decoupling: 22uF/16V ceramic close to output
    c_buck_out = new Capacitor
    c_buck_out.value = 22uF +/- 20%
    c_buck_out.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_5v ~ c_buck_out.p1; c_buck_out.p2 ~ gnd

    # Feedback resistor divider: sets Vout = 0.8V * (1 + R_fb_top/R_fb_bot)
    # 210kohm / 40kohm => 0.8 * (1 + 5.25) = 0.8 * 6.25 = 5.0V
    # Using datasheet-recommended values for 5V output
    r_fb_top = new Resistor
    r_fb_top.value = 210kohm +/- 1%
    rail_5v ~ r_fb_top.p1; r_fb_top.p2 ~ buck.fb

    r_fb_bot = new Resistor
    r_fb_bot.value = 40kohm +/- 1%
    buck.fb ~ r_fb_bot.p1; r_fb_bot.p2 ~ gnd

    # Frequency set resistor: 100kohm to GND gives ~300kHz switching
    # Higher frequency = smaller inductor but more switching loss
    # 300kHz is a good trade-off for drone applications (EMI vs efficiency)
    r_freq = new Resistor
    r_freq.value = 100kohm +/- 1%
    buck.freq ~ r_freq.p1; r_freq.p2 ~ gnd

    # Compensation network on COMP pin for loop stability
    # Series RC: 100kohm + 150pF — tunes error amplifier bandwidth
    r_comp = new Resistor
    r_comp.value = 100kohm +/- 1%
    c_comp = new Capacitor
    c_comp.value = 150pF +/- 10%
    buck.comp ~ r_comp.p1; r_comp.p2 ~ c_comp.p1; c_comp.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 2b: 10V VTX BEC (MP1584EN)
    # Input: VBAT (7.4-25.2V), Output: 10V/2A (max 3A)
    # Dedicated regulator for VTX power — matches Brave F7 reference
    # EN tied to VIN = always-on; PINIO1 P-FET switches output to connector
    # Feedback divider: 115k/10k for 10V output
    #   Vout = 0.8V * (1 + 115k/10k) = 0.8 * 12.5 = 10.0V
    # ═══════════════════════════════════════════════

    # Internal 10V rail (unswitched, between BEC output and PINIO1 P-FET)
    signal rail_10v

    buck_10v = new MP1584EN

    # Input power connections
    buck_10v.vin ~ vbat
    buck_10v.gnd ~ gnd

    # Enable: tie to VIN for always-on operation
    buck_10v.en ~ vbat

    # Input decoupling: 22uF/35V ceramic close to VIN pin
    c_buck_10v_in = new Cap_22uF_35V
    buck_10v.vin ~ c_buck_10v_in.p1; c_buck_10v_in.p2 ~ gnd

    # Bootstrap capacitor: 100nF between BST and SW pins
    c_buck_10v_bst = new Capacitor
    c_buck_10v_bst.value = 100nF +/- 10%
    buck_10v.bst ~ c_buck_10v_bst.p1; c_buck_10v_bst.p2 ~ buck_10v.sw

    # Output inductor: 4.7uH/3A shielded
    inductor_10v = new Inductor_4u7
    buck_10v.sw ~ inductor_10v.p1; inductor_10v.p2 ~ rail_10v

    # Schottky catch diode: anode to GND, cathode to SW node
    d_buck_10v = new Schottky_SS34
    d_buck_10v.anode ~ gnd
    d_buck_10v.cathode ~ buck_10v.sw

    # Output decoupling: 22uF ceramic (needs ≥16V rating for 10V output)
    c_buck_10v_out = new Capacitor
    c_buck_10v_out.value = 22uF +/- 20%
    c_buck_10v_out.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_10v ~ c_buck_10v_out.p1; c_buck_10v_out.p2 ~ gnd

    # Feedback resistor divider: 115k/10k for 10V output
    # Vout = 0.8V * (1 + 115k/10k) = 0.8 * 12.5 = 10.0V
    r_fb_10v_top = new Resistor
    r_fb_10v_top.value = 115kohm +/- 1%
    rail_10v ~ r_fb_10v_top.p1; r_fb_10v_top.p2 ~ buck_10v.fb

    r_fb_10v_bot = new Resistor
    r_fb_10v_bot.value = 10kohm +/- 1%
    buck_10v.fb ~ r_fb_10v_bot.p1; r_fb_10v_bot.p2 ~ gnd

    # Frequency set resistor: 100kohm (~300kHz switching)
    r_freq_10v = new Resistor
    r_freq_10v.value = 100kohm +/- 1%
    buck_10v.freq ~ r_freq_10v.p1; r_freq_10v.p2 ~ gnd

    # Compensation network: series RC for loop stability
    r_comp_10v = new Resistor
    r_comp_10v.value = 100kohm +/- 1%
    c_comp_10v = new Capacitor
    c_comp_10v.value = 150pF +/- 10%
    buck_10v.comp ~ r_comp_10v.p1; r_comp_10v.p2 ~ c_comp_10v.p1; c_comp_10v.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 3: 3.3V LDO (AMS1117-3.3)
    # Input: 5V rail, Output: 3.3V
    # Power dissipation: (5.0-3.3) * 0.2A = 0.34W — trivial for SOT-223
    # ═══════════════════════════════════════════════

    ldo = new AMS1117_3V3
    ldo.vin ~ rail_5v
    ldo.vout ~ rail_3v3
    ldo.gnd ~ gnd

    # Input cap: 10uF ceramic close to LDO input pin
    c_ldo_in = new Capacitor
    c_ldo_in.value = 10uF +/- 20%
    c_ldo_in.footprint = "Capacitor_SMD:C_0805_2012Metric"
    ldo.vin ~ c_ldo_in.p1; c_ldo_in.p2 ~ gnd

    # Output cap: 22uF tantalum close to LDO output (REQUIRED for stability)
    # AMS1117 requires output cap with ESR in 0.1-0.5 ohm range (tantalum ideal)
    # Low-ESR ceramic MLCCs can cause oscillation on AMS1117
    c_ldo_out = new Cap_22uF_10V_Tant
    ldo.vout ~ c_ldo_out.p1; c_ldo_out.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 4: Battery Voltage Sensing
    # Resistor divider: 10kohm / 1kohm = 10:1 ratio
    # At max 6S (25.2V): 25.2 * 1/(10+1) = 2.29V (safe for 3.3V ADC)
    # 100nF filter cap across bottom resistor (low-pass with 1kohm ~ 1.6kHz)
    # Output goes to MCU PC2 (ADC_VBAT)
    # ═══════════════════════════════════════════════

    r_vbat_top = new Resistor
    r_vbat_top.value = 10kohm +/- 1%
    vbat ~ r_vbat_top.p1; r_vbat_top.p2 ~ adc_vbat

    r_vbat_bot = new Resistor
    r_vbat_bot.value = 1kohm +/- 1%
    adc_vbat ~ r_vbat_bot.p1; r_vbat_bot.p2 ~ gnd

    # Filter cap across bottom resistor reduces ADC noise
    c_vbat_filter = new Capacitor
    c_vbat_filter.value = 100nF +/- 10%
    adc_vbat ~ c_vbat_filter.p1; c_vbat_filter.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 5: Current Sensing
    # ESC provides analog current output — filter before ADC
    # RC low-pass: 1kohm + 100nF, fc = 1/(2*pi*1k*100n) ~= 1.6kHz
    # Output goes to MCU PC1 (ADC_CURR)
    # ═══════════════════════════════════════════════

    r_curr_filter = new Resistor
    r_curr_filter.value = 1kohm +/- 1%
    curr_in ~ r_curr_filter.p1; r_curr_filter.p2 ~ adc_curr

    c_curr_filter = new Capacitor
    c_curr_filter.value = 100nF +/- 10%
    adc_curr ~ c_curr_filter.p1; c_curr_filter.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 6: PINIO1 VTX Power Switch (N-FET + P-FET level-shifted)
    # Controls 10V BEC output to VTX connector via PB2 (PINIO1)
    #
    # N-FET (2N7002) level shifter required because PB2 (3.3V max) cannot
    # directly drive P-FET gate to the 10V source voltage for reliable turn-off.
    # The N-FET inverts the signal and provides full rail-to-rail gate drive.
    #
    # PB2 HIGH → N-FET ON → P-FET gate at GND → Vgs=-10V → P-FET ON → VTX powered
    # PB2 LOW  → N-FET OFF → pullup pulls gate to 10V → Vgs=0 → P-FET OFF → VTX off
    #
    # Default state: PB2 has 10k pulldown (BOOT1) → VTX off at power-on.
    # Betaflight firmware sets PB2 high at boot to enable VTX power.
    # This is safer than always-on: prevents accidental high-power transmission.
    # ═══════════════════════════════════════════════

    # N-FET level shifter: 2N7002 SOT-23
    q_pinio_nfet = new NFET_2N7002

    # Gate resistor: PB2 → 10kΩ → N-FET gate (limits inrush, ESD protection)
    r_pinio_gate = new Resistor
    r_pinio_gate.value = 10kohm +/- 1%
    pinio1 ~ r_pinio_gate.p1; r_pinio_gate.p2 ~ q_pinio_nfet.gate
    q_pinio_nfet.source ~ gnd

    # P-FET gate pullup: 100kΩ to rail_10v (holds P-FET OFF when N-FET is off)
    r_pinio_pullup = new Resistor
    r_pinio_pullup.value = 100kohm +/- 1%
    q_pinio_nfet.drain ~ r_pinio_pullup.p1; r_pinio_pullup.p2 ~ rail_10v

    # P-FET high-side switch: source=10V rail, drain=VTX connector output
    pinio_fet = new AO3401A
    pinio_fet.source ~ rail_10v
    pinio_fet.drain ~ vtx_10v
    q_pinio_nfet.drain ~ pinio_fet.gate

    # ═══════════════════════════════════════════════
    # SECTION 7: USB Power OR Circuit
    # SS34 Schottky: VBUS -> 5V rail (forward biased when USB powered)
    # Prevents backfeed from BEC 5V into USB host
    # When BEC is active (5V > VBUS-Vf), Schottky reverse-biased = no backfeed
    # When only USB: VBUS - 0.5V forward drop ~= 4.5V on 5V rail (enough for 3.3V LDO)
    # 4.7uF decoupling on VBUS after Schottky
    # ═══════════════════════════════════════════════

    d_usb = new Schottky_SS34
    d_usb.anode ~ usb_vbus
    d_usb.cathode ~ rail_5v

    # VBUS decoupling after Schottky — note: this is on the 5V rail side
    # Additional decoupling specifically for USB power path
    c_usb_vbus = new Capacitor
    c_usb_vbus.value = 4.7uF +/- 10%
    c_usb_vbus.footprint = "Capacitor_SMD:C_0805_2012Metric"
    d_usb.cathode ~ c_usb_vbus.p1; c_usb_vbus.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 8: Bulk Decoupling
    # 5V rail: 2x 22uF MLCC near BEC output (absorbs load transients)
    # 3.3V rail: 22uF tantalum near LDO output (additional bulk storage)
    # ═══════════════════════════════════════════════

    # 2x 22uF/16V MLCC in 1206 — flat profile, replaces cylindrical electrolytic
    # Combined with c_buck_out (22uF), total 5V bulk is ~66uF nominal
    c_5v_bulk_1 = new Capacitor
    c_5v_bulk_1.value = 22uF +/- 20%
    c_5v_bulk_1.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_5v ~ c_5v_bulk_1.p1; c_5v_bulk_1.p2 ~ gnd

    c_5v_bulk_2 = new Capacitor
    c_5v_bulk_2.value = 22uF +/- 20%
    c_5v_bulk_2.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_5v ~ c_5v_bulk_2.p1; c_5v_bulk_2.p2 ~ gnd

    c_3v3_bulk = new Cap_22uF_10V_Tant
    rail_3v3 ~ c_3v3_bulk.p1; c_3v3_bulk.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # Assert Constraints (from specs/power.md)
    # Validates component values meet design requirements
    # ═══════════════════════════════════════════════

    # Battery voltage divider: 10:1 ratio components
    assert r_vbat_top.value within 9.9kohm to 10.1kohm
    assert r_vbat_bot.value within 990ohm to 1.01kohm

    # Current sense filter components
    assert r_curr_filter.value within 900ohm to 1.1kohm
    assert c_curr_filter.value within 80nF to 120nF

    # PINIO1 gate resistor and pullup
    assert r_pinio_gate.value within 9.9kohm to 10.1kohm
    assert r_pinio_pullup.value within 90kohm to 110kohm
