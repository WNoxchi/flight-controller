# Power subsystem: VBAT -> 5V Buck (LMR43620) -> 3.3V LDO (TLV75533)
# See specs/power.md for full requirements
#
# Design decisions:
# - TI LMR43620 synchronous buck converters (NDAA-compliant, TI fabs in Dallas TX)
#   5V BEC: LMR43620MB5RPER (fixed 5V, MODE/SYNC variant, 1MHz internal)
#   VTX BEC: LMR43620RNXTRPER (adjustable, RT variant, 10V output via FB divider)
#   VQFN-HR 2x2mm HotRod package (RPE0009B), 3-36V input, 2A max
#   Synchronous topology — no external Schottky catch diode needed
#   Internally compensated — no external COMP network needed
# - AMS1117-3.3 SOT-223 LDO: 5V input, 3.3V/1A output
#   22uF tantalum output cap required for stability (ESR-dependent loop compensation)
# - SMBJ26A TVS: clamp voltage ~29V protects against 6S voltage spikes
# - Battery voltage divider: 10k/1k gives 10:1 ratio, 25.2V -> 2.29V (safe for 3.3V ADC)
# - Current sense filter: 1kohm + 100nF RC low-pass, fc = 1/(2*pi*1k*100n) ~= 1.6kHz
# - PINIO1: AO3401A P-FET high-side switch for VTX 10V power control via PB2
#   10kohm gate resistor limits gate current and provides noise immunity
# - SS34 Schottky diode: USB power OR circuit prevents backfeed from BEC to USB host

from "mcu.ato" import Capacitor, Resistor
from "misc.ato" import NFET_2N7002

# ────────────────────────────────────────────────
# TI LMR43620 Synchronous Buck Converter — VQFN-HR 2x2mm (RPE0009B)
# Pin mapping from TI datasheet SNVSBY5B, Table 6-1
# Input: 3-36V (42V transient), Output: 2A max, synchronous (no ext diode)
# Internally compensated. HotRod flip-chip package, no exposed thermal pad.
# ────────────────────────────────────────────────

# Fixed 5V output variant (MODE/SYNC pin, 1MHz internal switching)
# TI marking "2MB5" — matches Brave F7 reference board
component LMR43620_5V:
    footprint = "lib:TI_RPE0009B_VQFN-HR-9_2x2mm_P0.5mm"
    mpn = "LMR43620MB5RPER"
    designator_prefix = "U"
    signal rt_mode ~ pin 1  # MODE/SYNC — tie to GND for forced-PWM, float for PFM
    signal pgood ~ pin 2    # Power good (open drain) — leave floating if unused
    signal en ~ pin 3       # Enable/UVLO — internal pullup to VIN; tie to VIN for always-on
    signal vin ~ pin 4      # Input supply (3-36V)
    signal sw ~ pin 5       # Switch node — connect to inductor
    signal boot ~ pin 6     # Bootstrap — 100nF cap to SW
    signal vcc ~ pin 7      # Internal 3.3V LDO output — 1uF bypass cap to GND
    signal fb ~ pin 8       # VOUT/FB — tie directly to 5V output (fixed variant)
    signal gnd ~ pin 9      # Ground (largest pad, primary thermal path)


# Adjustable output variant (RT pin sets switching frequency)
# TI marking "2RNX" — for 10V VTX BEC output
component LMR43620_ADJ:
    footprint = "lib:TI_RPE0009B_VQFN-HR-9_2x2mm_P0.5mm"
    mpn = "LMR43620RNXTRPER"
    designator_prefix = "U"
    signal rt ~ pin 1       # RT — external resistor to GND sets switching frequency
    signal pgood ~ pin 2    # Power good (open drain) — leave floating if unused
    signal en ~ pin 3       # Enable/UVLO — internal pullup to VIN; tie to VIN for always-on
    signal vin ~ pin 4      # Input supply (3-36V)
    signal sw ~ pin 5       # Switch node — connect to inductor
    signal boot ~ pin 6     # Bootstrap — 100nF cap to SW
    signal vcc ~ pin 7      # Internal 3.3V LDO output — 1uF bypass cap to GND
    signal fb ~ pin 8       # FB — external resistor divider sets output voltage
    signal gnd ~ pin 9      # Ground (largest pad, primary thermal path)

# ────────────────────────────────────────────────
# TLV75533PDBV LDO Voltage Regulator — SOT-23-5
# TI, NDAA-compliant (replaces Chinese AMS1117-3.3)
# Fixed 3.3V output, 500mA max, dropout ~145mV typical
# Stable with MLCC output caps (no ESR requirement)
# ────────────────────────────────────────────────
component TLV75533:
    footprint = "Package_TO_SOT_SMD:SOT-23-5"
    mpn = "TLV75533PDBVR"
    designator_prefix = "U"
    signal vin ~ pin 1     # Input supply
    signal gnd ~ pin 2     # Ground
    signal en ~ pin 3      # Enable (active high, internal pullup)
    # pin 4 = NC
    signal vout ~ pin 5    # Regulated 3.3V output

# ────────────────────────────────────────────────
# SMBJ26A TVS Diode — SMB package
# Standoff voltage: 26V, Clamping voltage: ~42.1V @ 1A (protects 6S LiPo)
# Unidirectional: cathode band toward VBAT (reverse-biased during normal operation)
# ────────────────────────────────────────────────
component TVS_SMBJ26A:
    footprint = "Diode_SMD:D_SMB"
    mpn = "SMBJ26A"
    designator_prefix = "D"
    signal anode ~ pin 1   # Connect to GND
    signal cathode ~ pin 2 # Connect to VBAT (reverse-biased)

# ────────────────────────────────────────────────
# SS54 Schottky Diode — SMA package
# 40V, 5A, Vf ~0.5V — used for USB power OR circuit
# Forward: anode=VBUS, cathode=5V rail (current flows USB→rail)
# ────────────────────────────────────────────────
component Schottky_SS54:
    footprint = "Diode_SMD:D_SMA"
    mpn = "SS54"
    designator_prefix = "D"
    signal anode ~ pin 1
    signal cathode ~ pin 2

# ────────────────────────────────────────────────
# AO3401A P-Channel MOSFET — SOT-23
# Vds=-30V, Id=-4A, Rds(on)=50mohm @ Vgs=-10V
# Used as high-side switch for VTX VBAT control (PINIO1)
# Pin mapping: SOT-23 standard for P-FET
# ────────────────────────────────────────────────
component AO3401A:
    footprint = "Package_TO_SOT_SMD:SOT-23"
    mpn = "AO3401A"
    designator_prefix = "Q"
    signal gate ~ pin 1    # Gate — driven by MCU PB2 via 10k resistor
    signal source ~ pin 2  # Source — connects to VBAT
    signal drain ~ pin 3   # Drain — connects to VTX VBAT_SW output

# ────────────────────────────────────────────────
# Shielded Power Inductor — for LMR43620 buck output
# 2.2uH, rated >= 2.5A saturation current, 4x4mm shielded
# TI datasheet Table 8-2 recommends 2.2uH for 1MHz/5V output
# Matches Brave F7 inductor (marking "C 222", 4.15x4.15mm)
# ────────────────────────────────────────────────
component Inductor_2u2:
    footprint = "Inductor_SMD:L_Wuerth_MAPI-4020"
    mpn = "74438356022"
    designator_prefix = "L"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

# ────────────────────────────────────────────────
# 47uF/10V tantalum, EIA-3528 (Kemet Case B)
# For 3.3V rail bulk decoupling and LDO output stability.
# TLV75533 is stable with MLCC, but tantalum kept for bulk storage
# and to match Brave F7 reference board.
# 47uF matches Brave F7 reference (marking "476A").
# ────────────────────────────────────────────────
component Cap_47uF_10V_Tant:
    footprint = "Capacitor_Tantalum_SMD:CP_EIA-3528-21_Kemet-B"
    mpn = "TAJB476K010RNJ"
    designator_prefix = "C"
    signal p1 ~ pin 1  # positive
    signal p2 ~ pin 2  # negative (GND)

# ────────────────────────────────────────────────
# Voltage-rated caps for VBAT rail (up to 25.2V on 6S LiPo)
# Pinned MPNs required because atopile v0.2.69 generic solver
# has no voltage_rating constraint — it picks cheapest by capacitance only.
# ────────────────────────────────────────────────

# 22uF/35V X5R MLCC, 1210 package
# Samsung CL32A226KAJNNNE — LCSC C24497, JLCPCB basic part
# 35V matches c_vbat_bulk rating; 72% derating at 25.2V (6S max)
component Cap_22uF_35V:
    footprint = "Capacitor_SMD:C_1210_3225Metric"
    mpn = "CL32A226KAJNNNE"
    designator_prefix = "C"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

# 4.7uF/50V X7R MLCC, 0805 package
# Samsung CL21B475KBFNNNE — 50V rated for VBAT rail (up to 25.2V)
# Smaller primary input cap for LMR43620 (synchronous, lower ripple current)
component Cap_4u7F_50V:
    footprint = "Capacitor_SMD:C_0805_2012Metric"
    mpn = "CL21B475KBFNNNE"
    designator_prefix = "C"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

# ────────────────────────────────────────────────
# PowerSystem module: complete power distribution
# ────────────────────────────────────────────────
module PowerSystem:
    # ── Power rails exposed to rest of system ──
    signal vbat      # Raw battery input (7.4-25.2V, 2-6S LiPo)
    signal rail_5v   # 5V regulated rail (from LMR43620 5V buck)
    signal rail_3v3  # 3.3V regulated rail (from AMS1117)
    signal gnd       # Common ground reference

    # ── Sensing signals (exposed to MCU ADC pins) ──
    signal adc_vbat  # Battery voltage sense output (to PC2, ~2.29V at 6S max)
    signal adc_curr  # Current sense filtered output (to PC1)

    # ── VTX 10V power (switched via PINIO1) ──
    signal vtx_10v   # PINIO1 switched 10V VTX output (to VTX connector)
    signal pinio1    # PINIO1 gate control input (from MCU PB2)

    # ── USB power OR input ──
    signal usb_vbus  # USB VBUS input (for power OR with BEC 5V)

    # ── ESC current sense input ──
    signal curr_in   # Raw current sense from ESC connector

    # ═══════════════════════════════════════════════
    # SECTION 1: VBAT Input Protection
    # TVS diode clamps voltage spikes (SMBJ26A, Vclamp ~42V)
    # 2x 22uF/35V MLCC bulk caps near battery pads
    # ═══════════════════════════════════════════════

    # TVS diode: cathode to VBAT, anode to GND (reverse-biased normally)
    tvs = new TVS_SMBJ26A
    tvs.cathode ~ vbat
    tvs.anode ~ gnd

    # Bulk input capacitors: 2x 22uF/35V MLCC (1210) near battery pads
    # Replaces single 100uF electrolytic — flat profile, lower ESR, no cylindrical cans
    # Effective ~44uF nominal (DC bias derating reduces this at 25.2V, still adequate
    # for high-frequency transient suppression from motor switching)
    c_vbat_bulk_1 = new Cap_22uF_35V
    vbat ~ c_vbat_bulk_1.p1; c_vbat_bulk_1.p2 ~ gnd
    c_vbat_bulk_2 = new Cap_22uF_35V
    vbat ~ c_vbat_bulk_2.p1; c_vbat_bulk_2.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 2: 5V Buck Regulator (TI LMR43620, fixed 5V)
    # Input: VBAT (7.4-25.2V), Output: 5V/2A
    # Fixed output variant — no feedback divider needed (FB ties to VOUT)
    # Synchronous — no external Schottky catch diode
    # Internally compensated — no external COMP network
    # MODE/SYNC pin tied to GND for forced-PWM operation
    # ═══════════════════════════════════════════════

    buck = new LMR43620_5V

    # Input power connections
    buck.vin ~ vbat
    buck.gnd ~ gnd

    # EN/UVLO divider: sets under-voltage lockout threshold
    # V_start = 1.22V × (1 + R_en_top/R_en_bot) = 1.22 × (1 + 430k/100k) = 6.47V rising
    # Hysteresis from 3.4µA internal current: V_stop ≈ 5.5V falling
    # Protects against operating on critically low battery
    r_en_top = new Resistor
    r_en_top.value = 430kohm +/- 1%
    r_en_top.package = "0402"
    vbat ~ r_en_top.p1; r_en_top.p2 ~ buck.en

    r_en_bot = new Resistor
    r_en_bot.value = 100kohm +/- 1%
    r_en_bot.package = "0402"
    buck.en ~ r_en_bot.p1; r_en_bot.p2 ~ gnd

    # Input caps: 4.7uF/50V primary + 100nF/50V HF bypass on VIN
    c_buck_in = new Cap_4u7F_50V
    buck.vin ~ c_buck_in.p1; c_buck_in.p2 ~ gnd

    c_buck_in_hf = new Capacitor
    c_buck_in_hf.value = 100nF +/- 10%
    c_buck_in_hf.package = "0402"
    buck.vin ~ c_buck_in_hf.p1; c_buck_in_hf.p2 ~ gnd

    # Bootstrap capacitor: 100nF from BOOT (pin 6) to SW (pin 5)
    c_bst = new Capacitor
    c_bst.value = 100nF +/- 10%
    buck.boot ~ c_bst.p1; c_bst.p2 ~ buck.sw

    # VCC bypass: 1uF from VCC (internal 3.3V LDO, pin 7) to GND
    c_vcc = new Capacitor
    c_vcc.value = 1uF +/- 20%
    c_vcc.package = "0402"
    buck.vcc ~ c_vcc.p1; c_vcc.p2 ~ gnd

    # MODE/SYNC (pin 1): tie to GND for forced-PWM (consistent switching freq)
    buck.rt_mode ~ gnd

    # PGOOD (pin 2): open-drain, pullup to output rail
    # Indicates output is in regulation — can be used for power sequencing
    r_pgood = new Resistor
    r_pgood.value = 100kohm +/- 1%
    r_pgood.package = "0402"
    buck.pgood ~ r_pgood.p1; r_pgood.p2 ~ rail_5v

    # FB (pin 8): tie directly to 5V output (fixed voltage variant)
    buck.fb ~ rail_5v

    # Output inductor: 4.7uH/3A shielded, connects SW to output
    inductor = new Inductor_2u2
    buck.sw ~ inductor.p1; inductor.p2 ~ rail_5v

    # Output decoupling: 2x 22uF ceramic close to output
    c_buck_out_1 = new Capacitor
    c_buck_out_1.value = 22uF +/- 20%
    c_buck_out_1.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_5v ~ c_buck_out_1.p1; c_buck_out_1.p2 ~ gnd

    c_buck_out_2 = new Capacitor
    c_buck_out_2.value = 22uF +/- 20%
    c_buck_out_2.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_5v ~ c_buck_out_2.p1; c_buck_out_2.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 2b: 10V VTX BEC (TI LMR43620, adjustable)
    # Input: VBAT (7.4-25.2V), Output: 10V/2A
    # Dedicated clean 10V for VTX — isolated from main 5V rail to reduce
    # video noise from digital switching on the main rail.
    # Adjustable variant with RT resistor (13kΩ → ~1MHz) and FB divider
    # (90.9kΩ/10kΩ → Vout = 1.0V × (1 + 90.9k/10k) = 10.09V).
    # Matches Brave F7 reference board 10V VTX output.
    # PINIO1 P-FET switches output to VTX connector (pit mode control).
    # ═══════════════════════════════════════════════

    # Dedicated VTX 10V rail (unswitched, between BEC output and PINIO1 P-FET)
    signal rail_10v_vtx

    buck_vtx = new LMR43620_ADJ

    # Input power connections
    buck_vtx.vin ~ vbat
    buck_vtx.gnd ~ gnd

    # EN/UVLO divider: same threshold as main 5V buck (6.47V rising, ~5.5V falling)
    r_en_vtx_top = new Resistor
    r_en_vtx_top.value = 430kohm +/- 1%
    r_en_vtx_top.package = "0402"
    vbat ~ r_en_vtx_top.p1; r_en_vtx_top.p2 ~ buck_vtx.en

    r_en_vtx_bot = new Resistor
    r_en_vtx_bot.value = 100kohm +/- 1%
    r_en_vtx_bot.package = "0402"
    buck_vtx.en ~ r_en_vtx_bot.p1; r_en_vtx_bot.p2 ~ gnd

    # Input caps: 4.7uF/50V primary + 100nF/50V HF bypass on VIN
    c_buck_vtx_in = new Cap_4u7F_50V
    buck_vtx.vin ~ c_buck_vtx_in.p1; c_buck_vtx_in.p2 ~ gnd

    c_buck_vtx_in_hf = new Capacitor
    c_buck_vtx_in_hf.value = 100nF +/- 10%
    c_buck_vtx_in_hf.package = "0402"
    buck_vtx.vin ~ c_buck_vtx_in_hf.p1; c_buck_vtx_in_hf.p2 ~ gnd

    # Bootstrap capacitor: 100nF from BOOT (pin 6) to SW (pin 5)
    c_buck_vtx_bst = new Capacitor
    c_buck_vtx_bst.value = 100nF +/- 10%
    buck_vtx.boot ~ c_buck_vtx_bst.p1; c_buck_vtx_bst.p2 ~ buck_vtx.sw

    # VCC bypass: 1uF from VCC (internal 3.3V LDO, pin 7) to GND
    c_vcc_vtx = new Capacitor
    c_vcc_vtx.value = 1uF +/- 20%
    c_vcc_vtx.package = "0402"
    buck_vtx.vcc ~ c_vcc_vtx.p1; c_vcc_vtx.p2 ~ gnd

    # PGOOD (pin 2): open-drain, pullup to output rail
    r_pgood_vtx = new Resistor
    r_pgood_vtx.value = 100kohm +/- 1%
    r_pgood_vtx.package = "0402"
    buck_vtx.pgood ~ r_pgood_vtx.p1; r_pgood_vtx.p2 ~ rail_10v_vtx

    # RT (pin 1): 13kΩ to GND sets switching frequency to ~1MHz
    # Per TI SNVSBY5B Table 8-1: R_RT = 13kΩ → f_SW ≈ 1MHz
    r_rt_vtx = new Resistor
    r_rt_vtx.value = 13kohm +/- 1%
    r_rt_vtx.package = "0402"
    buck_vtx.rt ~ r_rt_vtx.p1; r_rt_vtx.p2 ~ gnd

    # FB (pin 8): resistor divider sets output voltage
    # Vout = Vref × (1 + R_top/R_bot) = 1.0V × (1 + 90.9k/10k) = 10.09V
    r_fb_vtx_top = new Resistor
    r_fb_vtx_top.value = 90.9kohm +/- 1%
    r_fb_vtx_top.package = "0402"
    rail_10v_vtx ~ r_fb_vtx_top.p1; r_fb_vtx_top.p2 ~ buck_vtx.fb

    r_fb_vtx_bot = new Resistor
    r_fb_vtx_bot.value = 10kohm +/- 1%
    r_fb_vtx_bot.package = "0402"
    buck_vtx.fb ~ r_fb_vtx_bot.p1; r_fb_vtx_bot.p2 ~ gnd

    # Output inductor: 2.2uH shielded
    inductor_vtx = new Inductor_2u2
    buck_vtx.sw ~ inductor_vtx.p1; inductor_vtx.p2 ~ rail_10v_vtx

    # Output decoupling: 2x 22uF ceramic close to output
    c_buck_vtx_out_1 = new Capacitor
    c_buck_vtx_out_1.value = 22uF +/- 20%
    c_buck_vtx_out_1.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_10v_vtx ~ c_buck_vtx_out_1.p1; c_buck_vtx_out_1.p2 ~ gnd

    c_buck_vtx_out_2 = new Capacitor
    c_buck_vtx_out_2.value = 22uF +/- 20%
    c_buck_vtx_out_2.footprint = "Capacitor_SMD:C_1206_3216Metric"
    rail_10v_vtx ~ c_buck_vtx_out_2.p1; c_buck_vtx_out_2.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 3: 3.3V LDO (TI TLV75533, SOT-23-5)
    # Input: 5V rail, Output: 3.3V, 500mA max
    # Power dissipation: (5.0-3.3) * 0.2A = 0.34W — trivial for SOT-23-5
    # EN tied to VIN (always enabled)
    # ═══════════════════════════════════════════════

    ldo = new TLV75533
    ldo.vin ~ rail_5v
    ldo.vout ~ rail_3v3
    ldo.gnd ~ gnd
    ldo.en ~ rail_5v

    # Input cap: 10uF ceramic close to LDO input pin
    c_ldo_in = new Capacitor
    c_ldo_in.value = 10uF +/- 20%
    c_ldo_in.footprint = "Capacitor_SMD:C_0805_2012Metric"
    ldo.vin ~ c_ldo_in.p1; c_ldo_in.p2 ~ gnd

    # Output cap: 47uF tantalum (TLV75533 is stable with MLCC too, but
    # keeping tantalum to match Brave F7 reference and for bulk storage)
    c_ldo_out = new Cap_47uF_10V_Tant
    ldo.vout ~ c_ldo_out.p1; c_ldo_out.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 4: Battery Voltage Sensing
    # Resistor divider: 10kohm / 1kohm = 10:1 ratio
    # At max 6S (25.2V): 25.2 * 1/(10+1) = 2.29V (safe for 3.3V ADC)
    # 100nF filter cap across bottom resistor (low-pass with 1kohm ~ 1.6kHz)
    # Output goes to MCU PC2 (ADC_VBAT)
    # ═══════════════════════════════════════════════

    r_vbat_top = new Resistor
    r_vbat_top.value = 10kohm +/- 1%
    vbat ~ r_vbat_top.p1; r_vbat_top.p2 ~ adc_vbat

    r_vbat_bot = new Resistor
    r_vbat_bot.value = 1kohm +/- 1%
    adc_vbat ~ r_vbat_bot.p1; r_vbat_bot.p2 ~ gnd

    # Filter cap across bottom resistor reduces ADC noise
    c_vbat_filter = new Capacitor
    c_vbat_filter.value = 100nF +/- 10%
    adc_vbat ~ c_vbat_filter.p1; c_vbat_filter.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 5: Current Sensing
    # ESC provides analog current output — filter before ADC
    # RC low-pass: 1kohm + 100nF, fc = 1/(2*pi*1k*100n) ~= 1.6kHz
    # Output goes to MCU PC1 (ADC_CURR)
    # ═══════════════════════════════════════════════

    r_curr_filter = new Resistor
    r_curr_filter.value = 1kohm +/- 1%
    curr_in ~ r_curr_filter.p1; r_curr_filter.p2 ~ adc_curr

    c_curr_filter = new Capacitor
    c_curr_filter.value = 100nF +/- 10%
    adc_curr ~ c_curr_filter.p1; c_curr_filter.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 6: PINIO1 VTX Power Switch (N-FET + P-FET level-shifted)
    # Controls VTX 10V BEC output to VTX connector via PB2 (PINIO1)
    #
    # N-FET (2N7002) level shifter required because PB2 (3.3V max) cannot
    # directly drive P-FET gate to the 10V source voltage for reliable turn-off.
    # The N-FET inverts the signal and provides full rail-to-rail gate drive.
    #
    # PB2 HIGH → N-FET ON → P-FET gate at GND → Vgs=-10V → P-FET ON → VTX powered
    # PB2 LOW  → N-FET OFF → pullup pulls gate to 10V → Vgs=0 → P-FET OFF → VTX off
    #
    # Default state: PB2 has 10k pulldown (BOOT1) → VTX off at power-on.
    # Betaflight firmware sets PB2 high at boot to enable VTX power.
    # This is safer than always-on: prevents accidental high-power transmission.
    # ═══════════════════════════════════════════════

    # N-FET level shifter: 2N7002 SOT-23
    q_pinio_nfet = new NFET_2N7002

    # Gate resistor: PB2 → 10kΩ → N-FET gate (limits inrush, ESD protection)
    r_pinio_gate = new Resistor
    r_pinio_gate.value = 10kohm +/- 1%
    pinio1 ~ r_pinio_gate.p1; r_pinio_gate.p2 ~ q_pinio_nfet.gate
    q_pinio_nfet.source ~ gnd

    # P-FET gate pullup: 100kΩ to rail_10v_vtx (holds P-FET OFF when N-FET is off)
    r_pinio_pullup = new Resistor
    r_pinio_pullup.value = 100kohm +/- 1%
    q_pinio_nfet.drain ~ r_pinio_pullup.p1; r_pinio_pullup.p2 ~ rail_10v_vtx

    # P-FET high-side switch: source=10V VTX rail, drain=VTX connector output
    # AO3401A rated -30V Vds, -4A Id — handles 10V Vgs with margin
    pinio_fet = new AO3401A
    pinio_fet.source ~ rail_10v_vtx
    pinio_fet.drain ~ vtx_10v
    q_pinio_nfet.drain ~ pinio_fet.gate

    # ═══════════════════════════════════════════════
    # SECTION 7: USB Power OR Circuit
    # SS54 Schottky: VBUS -> 5V rail (forward biased when USB powered)
    # Prevents backfeed from BEC 5V into USB host
    # When BEC is active (5V > VBUS-Vf), Schottky reverse-biased = no backfeed
    # When only USB: VBUS - 0.5V forward drop ~= 4.5V on 5V rail (enough for 3.3V LDO)
    # 4.7uF decoupling on VBUS after Schottky
    # ═══════════════════════════════════════════════

    d_usb = new Schottky_SS54
    d_usb.anode ~ usb_vbus
    d_usb.cathode ~ rail_5v

    # VBUS decoupling after Schottky — note: this is on the 5V rail side
    # Additional decoupling specifically for USB power path
    c_usb_vbus = new Capacitor
    c_usb_vbus.value = 4.7uF +/- 10%
    c_usb_vbus.footprint = "Capacitor_SMD:C_0805_2012Metric"
    d_usb.cathode ~ c_usb_vbus.p1; c_usb_vbus.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # SECTION 8: Bulk Decoupling
    # 5V rail: 2x 22uF output caps in SECTION 2 provide bulk (total ~44uF)
    # 3.3V rail: 47uF tantalum near LDO output (additional bulk storage)
    # ═══════════════════════════════════════════════

    c_3v3_bulk = new Cap_47uF_10V_Tant
    rail_3v3 ~ c_3v3_bulk.p1; c_3v3_bulk.p2 ~ gnd

    # ═══════════════════════════════════════════════
    # Assert Constraints (from specs/power.md)
    # Validates component values meet design requirements
    # ═══════════════════════════════════════════════

    # Battery voltage divider: 10:1 ratio components
    assert r_vbat_top.value within 9.9kohm to 10.1kohm
    assert r_vbat_bot.value within 990ohm to 1.01kohm

    # Current sense filter components
    assert r_curr_filter.value within 900ohm to 1.1kohm
    assert c_curr_filter.value within 80nF to 120nF

    # PINIO1 gate resistor and pullup
    assert r_pinio_gate.value within 9.9kohm to 10.1kohm
    assert r_pinio_pullup.value within 90kohm to 110kohm
