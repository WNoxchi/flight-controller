# Power subsystem: VBAT -> 5V Buck -> 3.3V LDO
# See specs/power.md for full requirements

module PowerSystem:
    # Power rails exposed to rest of system
    signal vbat      # Raw battery input (7.4-25.2V)
    signal rail_5v   # 5V regulated rail
    signal rail_3v3  # 3.3V regulated rail
    signal gnd       # Common ground

